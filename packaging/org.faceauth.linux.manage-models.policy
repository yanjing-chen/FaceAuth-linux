<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>FaceAuth Rebuild</vendor>
  <action id="org.faceauth.linux.manage-models">
    <description>Enroll or delete face models</description>
    <message>Administrator authorization is required to add or remove face recognition data.</message>
    <description xml:lang="zh_CN">录入或删除人脸模板</description>
    <message xml:lang="zh_CN">添加或删除人脸识别数据需要管理员认证，以防止他人在当前会话中偷偷登记或删除人脸。</message>
    <defaults>
      <allow_any>no</allow_any>
      <!-- 允许非活动会话弹框认证：本机会话被 polkit 标为 inactive，
           若设为 no 会直接拒绝且不弹授权框，用户根本没有输密码的机会。
           仍然要求管理员密码，安全性不降低。 -->
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
