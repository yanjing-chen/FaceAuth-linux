[Unit]
Description=FaceAuth Linux privileged camera and authentication daemon
After=local-fs.target systemd-udev-settle.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/libexec/faceauth-linux/faceauth-daemon
RuntimeDirectory=faceauth-linux
RuntimeDirectoryMode=0755
StateDirectory=faceauth-linux
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
# Deliberately do not use ProtectHome or PrivateDevices: the daemon needs
# owner-only per-user config and V4L2 devices. PAM writes happen only after
# interactive administrator authorization; scene paths are allowlisted.

[Install]
WantedBy=multi-user.target
